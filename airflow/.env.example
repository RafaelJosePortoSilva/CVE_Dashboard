# Copie para `.env` nesta pasta e ajuste os valores.
# O compose usa este arquivo apenas para interpolação (${...}).

# UID do usuário dono dos arquivos do projeto.
# No Linux, use o resultado de `id -u`.
AIRFLOW_UID=1000

# Chave de criptografia de Connections/Variables do Airflow.
# Gere uma nova com:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=nSj6_2AnCHSudzUxDsNWkAcZvj6epw_dCO7j7XOMzok=

# Segredo JWT da API do Airflow 3.
AIRFLOW__API_AUTH__JWT_SECRET=troque-este-segredo

# Credenciais do usuário administrador da interface.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Limites do DuckDB usados pelo DAG (o host precisa ter memória de sobra).
CVE_DUCKDB_MEMORY_LIMIT=2GB
CVE_DUCKDB_THREADS=2
